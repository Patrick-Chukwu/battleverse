# Copy to .env.local (gitignored). Without these, the app stays in guest/local mode.
# Get these from Supabase → Project Settings → API.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# Default is on when the two vars above are set. Set false to keep local-only profiles.
# VITE_USE_SERVER_PROFILE=true

# Default on when Supabase is configured. Set false to keep Practice on bundled quizData.ts only.
# VITE_USE_DEXIE_QUESTIONS=true

# Default on when Supabase is configured. Set false to keep local bot battles.
# VITE_USE_LIVE_BATTLE=true

# Default on when live battle is on. Set false to hide Challenge / invite UI.
# VITE_USE_INVITES=true

# Default on when Supabase is configured. Set false to hide exam papers.
# VITE_USE_EXAM_MODES=true
